<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FlowNRW.Resources.Styles.Colors">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#0058BC</Color>
    <Color x:Key="PrimaryDark">#A5C9FF</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#E8F0FC</Color>
    <Color x:Key="SecondaryDarkText">#F5F5F7</Color>
    <Color x:Key="CanvasLight">#FAF9FE</Color>
    <Color x:Key="CanvasDark">#000000</Color>
    <Color x:Key="CardLight">#FFFFFF</Color>
    <Color x:Key="CardDark">#1C1C1E</Color>
    <Color x:Key="InkLight">#1A1B1F</Color>
    <Color x:Key="InkDark">#F5F5F7</Color>
    <Color x:Key="MutedLight">#414755</Color>
    <Color x:Key="MutedDark">#C5C7D0</Color>
    <Color x:Key="OutlineLight">#E3E2E7</Color>
    <Color x:Key="OutlineDark">#414149</Color>
    <Color x:Key="GroupStrong">#EEEDF3</Color>
    <Color x:Key="GroupStrongDark">#2C2C2E</Color>
    <Color x:Key="Success">#006E28</Color>
    <Color x:Key="Warning">#894D00</Color>
    <Color x:Key="Error">#BA1A1A</Color>
    <!-- Kontrastgeprüfte Semantik-Dunkelvarianten auf CardDark #1C1C1E / GroupStrongDark #2C2C2E:
         SuccessDark #3ECF6B ≈ 8,4:1 / 6,9:1, WarningDark #F0A840 ≈ 8,4:1 / 6,9:1,
         ErrorDark #FF897D ≈ 7,4:1 / 6,1:1 — alle ≥4,5:1 (WCAG AA Normaltext). -->
    <Color x:Key="SuccessDark">#3ECF6B</Color>
    <Color x:Key="WarningDark">#F0A840</Color>
    <Color x:Key="ErrorDark">#FF897D</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>
</ResourceDictionary>
