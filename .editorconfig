root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cs,csproj,props,targets,xaml,xml,sln}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json,mjs,cjs,js,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Compiler-generated sources (XAML source generators etc.) are not documented by hand.
[**/obj/**.cs]
generated_code = true
dotnet_diagnostic.CS1591.severity = none
